# Copy to .env and fill in. Never commit the real .env.

# --- LLM (required for AI features) ---
GROQ_API_KEY=your_groq_api_key_here
# Optional overrides. Defaults: openai/gpt-oss-120b, then openai/gpt-oss-20b if it is rate-limited.
# NOTE: Groq retired llama-3.3-70b-versatile and llama-3.1-8b-instant on 2026-08-16 (404
# model_not_found). Current models: https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
# Groq's free tier allows ~8k tokens/minute per model; requests are sized to fit. Paid tiers
# can raise the per-request budget (prompt + answer) for every model:
# GROQ_TOKEN_BUDGET=7000

# --- Security (generate both with: python utils/generate_keys.py) ---
JWT_SECRET_KEY=
ENCRYPTION_KEY=

# --- Case search ---
# Indian Kanoon API token (falls back to web scraping if empty)
INDIAN_KANOON_TOKEN=

# --- Vector DB ---
# Leave empty locally to use the embedded ./qdrant_db; set both for Qdrant Cloud.
QDRANT_URL=
QDRANT_API_KEY=

# --- User database ---
# Leave empty locally to use SQLite. In production use a hosted Postgres, e.g.
# postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Optional: extra allowed CORS origins, comma-separated
# CORS_ORIGINS=https://my-custom-domain.com
